# --- secrets ---------------------------------------------------------------
# .env holds DATABASE_URL credentials and DATA_GOV_KEY. Never commit it;
# .env.example is the committed template.
.env
.env.local
*.pem
*.key
credentials.json

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / OS ----------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# --- runtime / logs --------------------------------------------------------
*.log
*.pid

# --- derived data ----------------------------------------------------------
# The SQLite database is a build artifact. Recreate it with:
#     python -m backend.seed.load_db --reset
# (or `make reset-db`) -- it is rebuilt from the committed reference files in
# data/ref/ and data/raw/clean.parquet, so there is no reason to version it.
data/*.db
data/*.sqlite
data/*.sqlite3

# The 737k-row intermediate between the source CSV and the cleaned slice.
# Regenerate with `make history` -- it is fully derived from
# Agriculture_price_dataset.csv, which IS committed.
data/raw/agmarknet_history.parquet

# NOTE: these are deliberately NOT ignored, because the app and the ETL read
# them and they are small enough to keep the repo self-contained:
#   Agriculture_price_dataset.csv        the source dump (52.7 MB)
#   data/raw/clean.parquet               the Karnataka slice the app loads
#   data/raw/clean_demo.parquet          a small demo slice
#   data/ref/mandis.csv                  mandi coordinates + geocode provenance
#   data/ref/dist_matrix.parquet         farm -> mandi distances
#   data/ref/params.yaml                 every cost assumption
