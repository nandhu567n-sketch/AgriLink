# Primary backend setting. Defaults to PostgreSQL if unset.
DATABASE_URL=postgresql+psycopg2://agrilink:agrilink@localhost:5432/agrilink

# Zero-setup alternative -- no database server needed, reloaded with --reset:
# DATABASE_URL=sqlite:///./data/agrilink_dev.db

# Optional: browser origins allowed through CORS (comma separated).
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# Optional: live current prices (make fetch). Free key from data.gov.in.
DATA_GOV_KEY=your_free_key_from_data.gov.in
